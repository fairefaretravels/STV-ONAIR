{
  "name": "fraidy-cats-intro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "audio": "python3 scripts/generate_audio.py",
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "still": "remotion still FraidyCatsIntro out/still.png --frame=1560",
    "render": "remotion render FraidyCatsIntro out/fraidy-cats-intro.mp4 --codec=h264 --crf=16",
    "render:draft": "remotion render FraidyCatsIntro out/draft.mp4 --scale=0.5 --crf=28"
  },
  "dependencies": {
    "@remotion/cli": "4.0.250",
    "@remotion/google-fonts": "4.0.250",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.250"
  },
  "devDependencies": {
    "@types/react": "18.3.3",
    "typescript": "5.5.4"
  }
}
